{
  "realm": "bifrost-local",
  "displayName": "Bifrost Local",
  "enabled": true,
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "roles": {
    "realm": [
      { "name": "bifrost-admin", "description": "Bifrost administrator" },
      { "name": "bifrost-developer", "description": "Bifrost developer" },
      { "name": "bifrost-viewer", "description": "Bifrost read-only user" }
    ]
  },
  "groups": [
    { "name": "Engineering" },
    { "name": "Platform" }
  ],
  "clients": [
    {
      "clientId": "bifrost-oidc",
      "name": "Bifrost local development",
      "description": "Development-only OIDC client for Bifrost",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "bifrost-local-secret-change-me",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "redirectUris": [
        "http://localhost:3000/api/session/oidc/callback",
        "http://127.0.0.1:3000/api/session/oidc/callback",
        "http://localhost:8080/api/session/oidc/callback"
      ],
      "webOrigins": [
        "http://localhost:3000",
        "http://127.0.0.1:3000",
        "http://localhost:8080",
        "http://127.0.0.1:8080"
      ],
      "defaultClientScopes": ["web-origins", "acr", "roles", "profile", "email"],
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "full.path": "true",
            "claim.name": "groups",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "admin@bifrost.local",
      "email": "admin@bifrost.local",
      "firstName": "Bifrost",
      "lastName": "Admin",
      "enabled": true,
      "emailVerified": true,
      "realmRoles": ["bifrost-admin"],
      "groups": ["/Engineering", "/Platform"],
      "credentials": [
        { "type": "password", "value": "bifrost-local-admin", "temporary": false }
      ]
    }
  ]
}
